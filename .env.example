# Copy to .env to override defaults. Every value below is optional —
# docker compose up works with no .env file at all.

# Host ports published by docker compose (MySQL and Elasticsearch are bound to 127.0.0.1
# on non-default ports so they never collide with local installations)
API_PORT=3000
MYSQL_PORT=3307
ELASTICSEARCH_PORT=9201

# MySQL credentials (used by the mysql container AND the api/seed containers)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ecommerce
MYSQL_USER=app
MYSQL_PASSWORD=app

# Elasticsearch
ES_JAVA_OPTS=-Xms512m -Xmx512m
ELASTICSEARCH_INDEX=products

# Seed
DATA_SOURCE_URL=https://dummyjson.com
SEED_FALLBACK_TO_SNAPSHOT=true

# App
LOG_LEVEL=info
